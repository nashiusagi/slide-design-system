{
  "name": "slide-design-system",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@8.14.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "theme:generate": "node scripts/generate-theme.mjs",
    "theme:check": "node scripts/generate-theme.mjs --check",
    "design:check": "node scripts/validate-design.mjs",
    "canonical:check": "node scripts/check-canonical-duplication.mjs",
    "experiment:starter:check": "node scripts/prepare-workspace.mjs check-starter experiments/harness-intro",
    "public:sanitize": "node scripts/sanitize-run-artifacts.mjs",
    "public:audit": "node scripts/audit-public-data.mjs",
    "measure": "node scripts/measure-slides.mjs",
    "lint": "eslint . --max-warnings=0",
    "test": "vitest run",
    "check": "pnpm design:check && pnpm canonical:check && pnpm experiment:starter:check && pnpm public:audit && pnpm theme:check && pnpm typecheck && pnpm lint && pnpm test && pnpm build"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.4.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "ajv": "^8.20.0",
    "eslint": "^10.10.0",
    "globals": "^17.12.0",
    "js-yaml": "^5.4.1",
    "jsdom": "^30.0.1",
    "playwright": "^1.63.0",
    "postcss": "^8.5.28",
    "postcss-selector-parser": "^7.1.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.69.0",
    "vite": "^8.2.2",
    "vitest": "^5.0.0"
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  }
}
