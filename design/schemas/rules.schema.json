{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/nashiusagi/slide-design-system/design/schemas/rules.schema.json",
  "title": "design/rules.json",
  "$comment": "検査ルールの契約を検証するスキーマ（DR-0009 / DR-0011 / DR-0056）。rules 配列がルールIDと method（lint / measure / review / content）の対応の正本になる。閾値（contrast / minFontSize / noRawScale）は各ルールの実装がここを読みに来る値で、DR 本文には複製しない（DR-0008 / DR-0012）。",
  "type": "object",
  "required": ["rules", "contrast", "minFontSize", "noRawScale", "noOverflow", "keyMessageConveyed", "layoutFit"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "$comment": { "type": "string" },
    "rules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "method", "severity", "description"],
        "allOf": [
          {
            "$comment": "review（人が判断する）と content（外部 API を使い pnpm check へ入れない、DR-0056）は、pnpm check の中で機械に走らせる入口を持たない。bypass フィクスチャを要求しても実行できないため、宣言そのものを求めない（DR-0044）。制約の本体は下の properties にある。",
            "if": {
              "required": ["method"],
              "properties": { "method": { "not": { "enum": ["review", "content"] } } }
            },
            "then": {
              "required": ["bypassAxes", "scopeExclusions"],
              "properties": { "bypassAxes": {}, "scopeExclusions": {} }
            }
          }
        ],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z]+(-[a-z]+)*$" },
          "method": {
            "type": "string",
            "enum": ["lint", "measure", "review", "content"],
            "description": "検査の実行手段。lint は ESLint、measure は Playwright での実測、review は人（DR-0011）、content は表示文字を契約と突き合わせる判定（DR-0056）。"
          },
          "severity": {
            "type": "string",
            "enum": ["error", "warn"],
            "description": "method が review のときは自動合否を持たないため常に無視される（README の検査表）。"
          },
          "description": { "type": "string", "minLength": 1 },
          "bypassAxes": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "description": "このルールが塞いだことを示すべき『書き方の軸』（DR-0044）。軸ごとに bypass フィクスチャの事例を1つ以上持つことを scripts/validate-design.mjs が検査する。",
            "items": {
              "type": "string",
              "enum": ["alternate-notation", "value-composition", "boundary", "enumeration-tail"]
            }
          },
          "scopeExclusions": {
            "type": "array",
            "uniqueItems": true,
            "description": "このルールが意図的に見ない領域（DR-0044）。ここに挙げた id ごとに、通ることを固定するフィクスチャの事例を1つ以上持つ。挙げていない見落としは抜け道であって除外ではない。",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["id", "description"],
              "properties": {
                "id": { "type": "string", "pattern": "^[a-z]+(-[a-z]+)*$" },
                "description": { "type": "string", "minLength": 1 }
              }
            }
          }
        }
      }
    },
    "contrast": {
      "type": "object",
      "additionalProperties": false,
      "required": ["surfaces", "requirements"],
      "description": "contrast ルール（measure）の閾値。scripts/validate-design.mjs の算出値検査と、将来の measure 実装が読む（DR-0008 / DR-0011 / DR-0033）。",
      "properties": {
        "$comment": { "type": "string" },
        "surfaces": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "requirements": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["role", "foregrounds", "minimum"],
            "properties": {
              "role": { "type": "string", "minLength": 1 },
              "foregrounds": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": { "type": "string", "minLength": 1 }
              },
              "minimum": { "type": "number", "exclusiveMinimum": 1 }
            }
          }
        }
      }
    },
    "minFontSize": {
      "type": "object",
      "additionalProperties": false,
      "required": ["px"],
      "description": "min-font-size ルール（measure）の下限（DR-0012）。",
      "properties": {
        "$comment": { "type": "string" },
        "px": { "type": "integer", "exclusiveMinimum": 0 }
      }
    },
    "noOverflow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["toleranceInPx"],
      "description": "no-overflow ルール（measure）の許容誤差（DR-0011 帰結）。",
      "properties": {
        "$comment": { "type": "string" },
        "toleranceInPx": { "type": "number", "minimum": 0 }
      }
    },
    "keyMessageConveyed": {
      "type": "object",
      "additionalProperties": false,
      "required": ["conveyanceMin", "reviewConfidence"],
      "description": "key-message-conveyed ルール（content）の閾値。scripts/score-slide-content.mjs が読む（DR-0056 決定3）。",
      "properties": {
        "$comment": { "type": "string" },
        "conveyanceMin": {
          "type": "number",
          "minimum": 0,
          "description": "合格線。判定は0から3の4段階で、確率加重された値が返る。"
        },
        "reviewConfidence": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1,
          "description": "これを下回る確信度の判定は、合否によらず人が見る対象として印を付ける。"
        }
      }
    },
    "layoutFit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reviewConfidence"],
      "description": "layout-fit ルール（content）の閾値。scripts/score-slide-content.mjs が読む（DR-0056 決定3）。",
      "properties": {
        "$comment": { "type": "string" },
        "reviewConfidence": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1,
          "description": "これを下回る確信度の判定は、合否によらず人が見る対象として印を付ける。"
        }
      }
    },
    "noRawScale": {
      "type": "object",
      "additionalProperties": false,
      "required": ["allowedLiterals"],
      "description": "no-raw-scale ルール（lint）が例外的に許す長さリテラル（DR-0011 帰結）。",
      "properties": {
        "$comment": { "type": "string" },
        "allowedLiterals": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
